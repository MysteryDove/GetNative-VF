{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GetNative VF",
  "version": "0.1.0",
  "identifier": "io.getnative.vf",
  "build": {
    "beforeDevCommand": "npm run build:engine:debug && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:engine && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GetNative VF",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680,
        "backgroundColor": "#151817"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "bundle-stage/bin/": "bin/",
      "bundle-stage/build-provenance.json": "build-provenance.json",
      "bundle-stage/share/getnative/THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
