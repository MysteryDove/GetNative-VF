# External reference checkouts are not product source.
/upstream/

# Native builds, generated toolchains, and benchmark artifacts.
/build/
/out/
/.cache/
/artifacts/
/.deps/
/captures/
/profiles/
CMakeUserPresets.json
compile_commands.json

# Native compiler outputs that may be emitted outside an out-of-tree build.
*.obj
*.o
*.a
*.lib
*.dll
*.exe
*.pdb
*.ilk
*.exp

*.air
*.metallib
*.dSYM/
*.profraw
*.profdata

# Tauri web and Rust build products.
/app/node_modules/
/app/dist/
/app/src-tauri/target/
/app/src-tauri/bundle-stage/
/app/src-tauri/ffmpeg-runtime/

# Local-only benchmark input. Commit its checksum/manifest, not the media frame.
/engine/bench/fixtures/6.2-1.png

# Local compiler/profiler output.
/*.plist
*.trace
*.tracev3
*.gputrace
*.spindump

# OMX plans are reviewable project artifacts; runtime/session state is local.
/.omx/*
!/.omx/plans/
!/.omx/plans/*.md
/.codex/

# Local configuration and credentials.
.env
.env.*
!.env.example
.envrc
.direnv/
.npmrc
.pypirc
*.local
*.pem
*.key
*.p12
*.pfx
*.mobileprovision

# Logs and package-manager diagnostics.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE and operating-system files.
.DS_Store
._*
Thumbs.db
.idea/
.vscode/
.vs/
*.suo
*.user
*.sw?
__pycache__/
/CMakeFiles/
