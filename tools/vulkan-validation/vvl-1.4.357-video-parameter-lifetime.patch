     bool IsSecondary(VkCommandBuffer cb) const;
 
+    // Blackwell video decode can read recording parameters at submission time.
+    // Keep the unwrapped deep copy until the recording is reset or destroyed.
+    struct VideoDecodeRecording {
+        VkCommandPool pool = VK_NULL_HANDLE;
+        std::vector<std::unique_ptr<vku::safe_VkVideoDecodeInfoKHR>> parameters;
+    };
+    std::mutex video_decode_mutex;
+    vvl::unordered_map<VkCommandBuffer, VideoDecodeRecording> video_decode_recordings;
+    void ClearVideoDecodeRecording(VkCommandBuffer command_buffer) {
+        std::lock_guard<std::mutex> lock(video_decode_mutex);
+        auto found = video_decode_recordings.find(command_buffer);
+        if (found != video_decode_recordings.end()) found->second.parameters.clear();
+    }
+    void ClearVideoDecodePool(VkCommandPool pool, bool destroy) {
+        std::lock_guard<std::mutex> lock(video_decode_mutex);
+        for (auto it = video_decode_recordings.begin(); it != video_decode_recordings.end();) {
+            if (it->second.pool != pool) { ++it; continue; }
+            if (destroy) it = video_decode_recordings.erase(it);
+            else { it->second.parameters.clear(); ++it; }
+        }
+    }
+
     Settings& settings;
     DispatchInstance* dispatch_instance;
 
