#version 460
#extension GL_GOOGLE_include_directive : require

#include "getnative_common.glsl"

layout(local_size_x_id = 4, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 0) const uint fixed_half_bandwidth = 0u;
layout(constant_id = 2) const uint fixed_bandwidth7_order = 0u;

void main() {
    const uint gid = gl_GlobalInvocationID.x;
    const uint candidate = gid / job.maximum_vector_count;
    const uint vector = gid - candidate * job.maximum_vector_count;
    if (candidate >= job.candidate_count) {
        return;
    }
    const AxisPlanDescriptor plan = plans[job.candidate_count + candidate];
    if (vector >= plan.vector_count) {
        return;
    }

    const uint input_base = plan.intermediate_or_native_base;
    const uint output_base = plan.workspace_base + vector;
    const uint stride = plan.vector_count;
    const uint half_bandwidth = fixed_half_bandwidth == 0u
        ? plan.half_bandwidth : fixed_half_bandwidth;
    for (uint i = 0u; i < plan.destination_size; ++i) {
        float sum = 0.0;
        const uint begin = plan.transpose_entries_base
            + transpose_offsets[plan.transpose_offsets_base + i];
        const uint end = plan.transpose_entries_base
            + transpose_offsets[plan.transpose_offsets_base + i + 1u];
        for (uint entry = begin; entry < end; ++entry) {
            float weighted = transpose_weights[entry]
                * workspace[input_base + transpose_indices[entry] * stride + vector];
            sum = sum + weighted;
        }
        const uint available = min(half_bandwidth, i);
        for (uint distance = available; distance >= 1u; --distance) {
            float weighted = lower_ld[plan.lower_ld_base
                + (distance - 1u) * plan.destination_size + i]
                * workspace[output_base + (i - distance) * stride];
            sum = sum - weighted;
        }
        float solved = sum
            * inverse_diagonal[plan.inverse_diagonal_base + i];
        workspace[output_base + i * stride] = solved;
    }

    if (plan.destination_size < 2u) {
        return;
    }
    for (uint i = plan.destination_size - 1u; i-- > 0u;) {
        float sum = 0.0;
        const uint available = min(half_bandwidth, plan.destination_size - i - 1u);
        if (fixed_bandwidth7_order != 0u
            || (fixed_half_bandwidth == 0u && plan.half_bandwidth == 3u)) {
            for (uint distance = 1u; distance <= available; ++distance) {
                float weighted = upper_l[plan.upper_l_base
                    + (distance - 1u) * plan.destination_size + i]
                    * workspace[output_base + (i + distance) * stride];
                sum = sum + weighted;
            }
        } else {
            for (uint distance = available; distance >= 1u; --distance) {
                float weighted = upper_l[plan.upper_l_base
                    + (distance - 1u) * plan.destination_size + i]
                    * workspace[output_base + (i + distance) * stride];
                sum = sum + weighted;
            }
        }
        float solved = workspace[output_base + i * stride] - sum;
        workspace[output_base + i * stride] = solved;
    }
}
