#version 460
#extension GL_GOOGLE_include_directive : require

#include "getnative_common.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 1) const uint fixed_forward_width = 0u;
layout(constant_id = 3) const uint horizontal_first_two_axis = 0u;

shared float reduction[256];

void main() {
    const uint group_index = gl_WorkGroupID.x;
    const uint thread_index = gl_LocalInvocationID.x;
    const uint candidate = group_index / job.groups_per_candidate;
    const uint part = group_index - candidate * job.groups_per_candidate;
    if (candidate >= job.candidate_count) {
        return;
    }
    const uint descriptor_index = job.maximum_vector_count;
    const AxisPlanDescriptor plan = plans[descriptor_index + candidate];
    const uint cropped_width = job.width - job.crop_left - job.crop_right;
    const uint cropped_height = job.height - job.crop_top - job.crop_bottom;
    const uint lane = part * 256u + thread_index;
    const uint raster_stride = job.groups_per_candidate * 256u;
    const uint stride_y = raster_stride / cropped_width;
    const uint stride_x = raster_stride - stride_y * cropped_width;
    uint y_offset = lane / cropped_width;
    uint x_offset = lane - y_offset * cropped_width;
    const bool horizontal = plan.direction == horizontal_axis;
    float sum = 0.0;

    while (y_offset < cropped_height) {
        const uint x = job.crop_left + x_offset;
        const uint y = job.crop_top + y_offset;
        const uint axis_index = horizontal ? x : y;
        const uint vector = horizontal ? y : x;
        const uint weight_base = plan.forward_weights_base
            + axis_index * plan.forward_width;
        const uint left = uint(forward_left[plan.forward_left_base + axis_index]);
        const uint native_stride = horizontal ? 1u
            : (horizontal_first_two_axis != 0u ? job.width : plan.vector_count);
        const uint native_base = horizontal_first_two_axis != 0u
            ? plan.intermediate_or_native_base : plan.workspace_base;
        const uint native = native_base + (horizontal
            ? vector * plan.destination_size + left
            : left * native_stride + vector);
        const uint width = fixed_forward_width == 0u
            ? plan.forward_width : fixed_forward_width;
        float reconstructed = 0.0;
        for (uint tap = 0u; tap < width; ++tap) {
            float weighted = forward_weights[weight_base + tap]
                * workspace[native + tap * native_stride];
            reconstructed = reconstructed + weighted;
        }
        float difference = abs(source_data[y * job.width + x] - reconstructed);
        if (difference > job.threshold) {
            sum = sum + difference;
        }

        const uint next_x = x_offset + stride_x;
        const bool carry = next_x >= cropped_width;
        x_offset = carry ? next_x - cropped_width : next_x;
        y_offset = y_offset + stride_y + (carry ? 1u : 0u);
    }

    reduction[thread_index] = sum;
    barrier();
    for (uint offset = 128u; offset > 0u; offset /= 2u) {
        if (thread_index < offset) {
            float combined = reduction[thread_index]
                + reduction[thread_index + offset];
            reduction[thread_index] = combined;
        }
        barrier();
    }
    if (thread_index == 0u) {
        partials[candidate * job.groups_per_candidate + part] = reduction[0];
    }
}
